# Local product shell — copy to .env if needed. Never commit real secrets.
# 产品显示名（首页/页脚）；默认「阅稿」
VTA_APP_NAME=阅稿
# APP_NAME=阅稿

# Optional deploy / observability (see also docker/ops.env.example)
# SENTRY_DSN=
# Local AV upload UI is hidden unless this is exactly lowercase true
# VTA_UPLOADS_ENABLED=
# VTA_BUSY_LOCK_PATH=

# API keys belong in config/config.jsonc and config/users.json — not here.

# Optional local Whisper interpreter (CapsWriter not required)
# Resolution order: config.local_whisper.python -> LOCAL_WHISPER_PYTHON -> AMY_PYTHON
# LOCAL_WHISPER_PYTHON=
# AMY_PYTHON=
